{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runwhen.com/credential-inventory/v1.json",
  "title": "CredentialInventory",
  "description": "What a runner reports (CON-2): credential references only, never material (D5).",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "runwhen.com/credential-inventory/v1"
    },
    "runner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "reportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "kind": {
            "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/credentialRefKind"
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "uniqueItems": true
          },
          "format": {
            "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/slug"
          },
          "state": {
            "enum": [
              "ok",
              "unreadable",
              "missing"
            ]
          },
          "error": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "hints": {
            "type": "object",
            "properties": {
              "contexts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 253
                    },
                    "cluster": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 253
                    },
                    "server": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048
                    },
                    "namespace": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 253
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false
                }
              },
              "serviceAccount": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253
              },
              "namespace": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253
              },
              "server": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "labels": {
                "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/labels"
              }
            }
          }
        },
        "required": [
          "id",
          "kind",
          "state"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "runner",
    "reportedAt",
    "references"
  ],
  "additionalProperties": false
}
