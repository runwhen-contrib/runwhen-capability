{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runwhen.com/credential-inventory/v1.json",
  "title": "CredentialInventory",
  "description": "What a runner reports (CON-2): credential references and non-secret hints only, never material (D5).",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "runwhen.com/credential-inventory/v1"
    },
    "runnerUuid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "reportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "kind": {
            "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/credentialRefKind"
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "content": {
            "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/slug"
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "uniqueItems": true
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "state": {
            "enum": [
              "ok",
              "unreadable",
              "invalid",
              "missing"
            ]
          },
          "errorCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "hints": {
            "type": "object",
            "properties": {
              "kubeconfig": {
                "type": "object",
                "properties": {
                  "contexts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 253
                        },
                        "cluster": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 253
                        },
                        "server": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048
                        },
                        "namespace": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 253
                        },
                        "authKind": {
                          "type": "string",
                          "pattern": "^(token|client-cert|auth-provider|none|exec:[A-Za-z0-9._-]+)$"
                        }
                      },
                      "required": [
                        "name"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "contexts"
                ],
                "additionalProperties": false
              },
              "inClusterSa": {
                "type": "object",
                "properties": {
                  "serviceAccount": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253
                  },
                  "namespace": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253
                  },
                  "apiServer": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                },
                "required": [
                  "serviceAccount",
                  "namespace"
                ],
                "additionalProperties": false
              },
              "gcpSaKey": {
                "type": "object",
                "properties": {
                  "clientEmail": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 320
                  },
                  "projectId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  }
                },
                "required": [
                  "clientEmail"
                ],
                "additionalProperties": false
              },
              "cloudIdentity": {
                "type": "object",
                "properties": {
                  "provider": {
                    "enum": [
                      "gcp",
                      "aws",
                      "azure"
                    ]
                  },
                  "principal": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "required": [
                  "provider",
                  "principal"
                ],
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind",
          "ref",
          "state"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "runnerUuid",
    "reportedAt",
    "entries"
  ],
  "additionalProperties": false
}
