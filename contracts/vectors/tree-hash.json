{
  "description": "tree_hash(input): sha256 over lines '<sha256(data)> <755|644> <path>\\n' sorted by the path's UTF-8 bytes. Input is a list of {path, dataBase64, executable}.",
  "cases": [
    {
      "name": "empty tree",
      "input": [],
      "expected": "sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    },
    {
      "name": "single file",
      "input": [
        {
          "path": "SKILL.md",
          "dataBase64": "IyBza2lsbAo=",
          "executable": false
        }
      ],
      "expected": "sha256:208aea9be946b36b01ed723c4758a276c23f49af20493ecad3be187ed212c38c"
    },
    {
      "name": "input order does not matter",
      "input": [
        {
          "path": "b.txt",
          "dataBase64": "Yg==",
          "executable": false
        },
        {
          "path": "a.txt",
          "dataBase64": "YQ==",
          "executable": false
        },
        {
          "path": "lib/c.py",
          "dataBase64": "YyA9IDEK",
          "executable": false
        }
      ],
      "expected": "sha256:f26fe856569da3485642130ec8bee14e6a14d69c12c184258cb19f26ac9362cd"
    },
    {
      "name": "executable bit",
      "input": [
        {
          "path": "run.sh",
          "dataBase64": "IyEvYmluL3NoCmVjaG8gaGkK",
          "executable": true
        }
      ],
      "expected": "sha256:ea53eb6dc30a8d9cbb9079b65f0d848f34994e9b38523dd4ab4329a9b7dc0bc5"
    },
    {
      "name": "same file without the executable bit",
      "input": [
        {
          "path": "run.sh",
          "dataBase64": "IyEvYmluL3NoCmVjaG8gaGkK",
          "executable": false
        }
      ],
      "expected": "sha256:b2ecf3430cc2827c189214d6e275fb7d546a8e41649dcd98191bc7b825817070"
    },
    {
      "name": "empty file",
      "input": [
        {
          "path": "lib/__init__.py",
          "dataBase64": "",
          "executable": false
        }
      ],
      "expected": "sha256:aeab0a29daf6b6e291332f050d020b33fb7bea21f307398e8994b4402b588767"
    },
    {
      "name": "paths sort by utf-8 bytes, not locale",
      "input": [
        {
          "path": "a",
          "dataBase64": "MQ==",
          "executable": false
        },
        {
          "path": "Z",
          "dataBase64": "Mg==",
          "executable": false
        },
        {
          "path": "é",
          "dataBase64": "Mw==",
          "executable": false
        },
        {
          "path": "a/b",
          "dataBase64": "NA==",
          "executable": false
        }
      ],
      "expected": "sha256:0a626880785a19409effa33583b475135f8809906caf30f58e9d1dc00a5cb325"
    },
    {
      "name": "binary content",
      "input": [
        {
          "path": "data.bin",
          "dataBase64": "",
          "executable": false
        }
      ],
      "expected": "sha256:1425bf70e5b2e0d5a5416e01455b27ed6d416bb44600e40e2f3a9f7acad5fabf"
    },
    {
      "name": "unicode path",
      "input": [
        {
          "path": "docs/naïve.md",
          "dataBase64": "bmHDr3ZlCg==",
          "executable": false
        }
      ],
      "expected": "sha256:3f1337066a4b101a3c63f19f3742816ee2a83c34971cbf8d66185d816b28b0f2"
    }
  ]
}
