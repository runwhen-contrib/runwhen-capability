{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runwhen.com/connection/v1.json",
  "title": "Connection",
  "description": "A connection record (D45, D67): credential + auth method + runner + scope + verified permissions.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "runwhen.com/connection/v1"
    },
    "name": {
      "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/slug"
    },
    "integration": {
      "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/pinnedPlugin"
    },
    "authMethod": {
      "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/slug"
    },
    "credentialRef": {
      "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/credentialRef"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "array"
        ]
      }
    },
    "runner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "root": {
      "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/resourcePath"
    },
    "selector": {
      "type": "object",
      "properties": {
        "types": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/qualifiedType"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "labels": {
          "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/labels"
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/resourcePath"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "types"
          ]
        },
        {
          "required": [
            "paths"
          ]
        }
      ]
    },
    "priority": {
      "type": "integer"
    },
    "state": {
      "enum": [
        "proposed",
        "active",
        "paused",
        "disabled"
      ]
    },
    "origin": {
      "enum": [
        "inventory",
        "manual",
        "declared"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "verified": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "pending",
            "ok",
            "failed"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "integration": {
          "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/pinnedPlugin"
        },
        "rules": {
          "type": "object",
          "additionalProperties": {
            "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/verdict"
          },
          "propertyNames": {
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "integration",
    "authMethod",
    "credentialRef",
    "runner"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "root"
      ],
      "not": {
        "required": [
          "selector"
        ]
      }
    },
    {
      "required": [
        "selector"
      ],
      "not": {
        "required": [
          "root"
        ]
      }
    }
  ]
}
