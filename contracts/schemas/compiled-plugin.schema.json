{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runwhen.com/compiled-plugin/v1.json",
  "title": "CompiledPlugin",
  "description": "What `rwtask compile` emits (.runwhen/compiled.json in the archive) and the registry index stores.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "runwhen.com/compiled-plugin/v1"
    },
    "compiler": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "contentHash": {
      "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/sha256"
    },
    "plugin": {
      "$ref": "https://schemas.runwhen.com/plugin/v1.json"
    },
    "integration": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "definition": {
              "$ref": "https://schemas.runwhen.com/integration/v1.json"
            },
            "permissionSchema": {
              "type": "object"
            },
            "facetSchemas": {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              }
            }
          },
          "required": [
            "definition"
          ],
          "additionalProperties": false
        }
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/slug"
          },
          "frontmatter": {
            "$ref": "https://schemas.runwhen.com/skill-frontmatter/v1.json"
          },
          "skillMdSha256": {
            "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/sha256"
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/relPath"
            }
          },
          "runtime": {
            "type": "string"
          },
          "taskNames": {
            "type": "array",
            "items": {
              "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/slug"
            }
          }
        },
        "required": [
          "name",
          "frontmatter",
          "skillMdSha256",
          "files",
          "taskNames"
        ],
        "additionalProperties": false
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/fullTaskRef"
          },
          "skill": {
            "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/slug"
          },
          "name": {
            "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/slug"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "script": {
            "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/relPath"
          },
          "runtime": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*@[0-9]+$"
          },
          "role": {
            "oneOf": [
              {
                "enum": [
                  "discovery",
                  "cli",
                  "permission-check",
                  "health"
                ]
              },
              {
                "type": "array",
                "items": {
                  "enum": [
                    "discovery",
                    "cli",
                    "permission-check",
                    "health"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              }
            ]
          },
          "appliesTo": {
            "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/appliesTo"
          },
          "readOnly": {
            "type": "boolean"
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "minItems": 1
          },
          "destructive": {
            "type": "boolean"
          },
          "idempotent": {
            "type": "boolean"
          },
          "dryRun": {
            "type": "boolean"
          },
          "credentials": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/credentialTypeName"
                },
                "vars": {
                  "type": "array",
                  "items": {
                    "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/envVarName"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rule": {
                  "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/permissionRule"
                },
                "hash": {
                  "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/sha256"
                }
              },
              "required": [
                "rule",
                "hash"
              ],
              "additionalProperties": false
            }
          },
          "settings": {
            "type": "object",
            "additionalProperties": {
              "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/settingSpec"
            },
            "propertyNames": {
              "pattern": "^[a-z][A-Za-z0-9]*$"
            }
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/inputSpec"
            },
            "propertyNames": {
              "pattern": "^[a-z][A-Za-z0-9]*$"
            }
          },
          "inputSchema": {
            "type": "object"
          },
          "outputs": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "jsonSchema": {
                      "type": "object"
                    },
                    "schemaRef": {
                      "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/relPath"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    }
                  },
                  "required": [
                    "jsonSchema"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "artifact": {
                      "type": "object",
                      "properties": {
                        "contentType": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 255
                        },
                        "maxSize": {
                          "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/quantity"
                        }
                      },
                      "required": [
                        "contentType"
                      ],
                      "additionalProperties": false
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    }
                  },
                  "required": [
                    "artifact"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "rw.discovery.summary.v1",
                        "rw.access.v1"
                      ]
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "propertyNames": {
              "pattern": "^[a-z][A-Za-z0-9]*$"
            }
          },
          "timeout": {
            "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/duration"
          },
          "resources": {
            "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/resources"
          },
          "tags": {
            "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/tags"
          },
          "hash": {
            "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/sha256"
          }
        },
        "required": [
          "ref",
          "skill",
          "name",
          "title",
          "description",
          "script",
          "runtime",
          "readOnly",
          "idempotent",
          "dryRun",
          "credentials",
          "permissions",
          "settings",
          "inputs",
          "inputSchema",
          "outputs",
          "tags",
          "hash"
        ],
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/slug"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "body": {
            "type": "string"
          },
          "words": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/sha256"
          }
        },
        "required": [
          "name",
          "description",
          "body",
          "words",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "knowledge": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/slug"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "appliesTo": {
            "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/appliesTo"
          },
          "resources": {
            "type": "array",
            "items": {
              "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/resourcePath"
            }
          },
          "tags": {
            "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/tags"
          },
          "body": {
            "type": "string"
          },
          "sha256": {
            "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/sha256"
          }
        },
        "required": [
          "name",
          "description",
          "body",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "apiVersion",
    "compiler",
    "contentHash",
    "plugin",
    "integration",
    "skills",
    "tasks",
    "rules",
    "knowledge"
  ],
  "additionalProperties": false,
  "$defs": {
    "compiledTask": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/fullTaskRef"
        },
        "skill": {
          "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/slug"
        },
        "name": {
          "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "script": {
          "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/relPath"
        },
        "runtime": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*@[0-9]+$"
        },
        "role": {
          "oneOf": [
            {
              "enum": [
                "discovery",
                "cli",
                "permission-check",
                "health"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "discovery",
                  "cli",
                  "permission-check",
                  "health"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        },
        "appliesTo": {
          "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/appliesTo"
        },
        "readOnly": {
          "type": "boolean"
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 1
        },
        "destructive": {
          "type": "boolean"
        },
        "idempotent": {
          "type": "boolean"
        },
        "dryRun": {
          "type": "boolean"
        },
        "credentials": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/credentialTypeName"
              },
              "vars": {
                "type": "array",
                "items": {
                  "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/envVarName"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule": {
                "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/permissionRule"
              },
              "hash": {
                "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/sha256"
              }
            },
            "required": [
              "rule",
              "hash"
            ],
            "additionalProperties": false
          }
        },
        "settings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/settingSpec"
          },
          "propertyNames": {
            "pattern": "^[a-z][A-Za-z0-9]*$"
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/inputSpec"
          },
          "propertyNames": {
            "pattern": "^[a-z][A-Za-z0-9]*$"
          }
        },
        "inputSchema": {
          "type": "object"
        },
        "outputs": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "jsonSchema": {
                    "type": "object"
                  },
                  "schemaRef": {
                    "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/relPath"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "required": [
                  "jsonSchema"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "artifact": {
                    "type": "object",
                    "properties": {
                      "contentType": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255
                      },
                      "maxSize": {
                        "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/quantity"
                      }
                    },
                    "required": [
                      "contentType"
                    ],
                    "additionalProperties": false
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "required": [
                  "artifact"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "rw.discovery.summary.v1",
                      "rw.access.v1"
                    ]
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              }
            ]
          },
          "propertyNames": {
            "pattern": "^[a-z][A-Za-z0-9]*$"
          }
        },
        "timeout": {
          "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/duration"
        },
        "resources": {
          "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/resources"
        },
        "tags": {
          "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/tags"
        },
        "hash": {
          "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/sha256"
