                "rw.discovery.summary.v1",
                "rw.access.v1"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
