    "compiledOutput": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "jsonSchema": {
              "type": "object"
            },
            "schemaRef": {
              "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/relPath"
            },
            "description": {
