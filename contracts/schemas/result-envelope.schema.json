{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runwhen.com/result-envelope/v1.json",
  "title": "ResultEnvelope",
  "description": "What every task run returns (D64). status is derived by the runner, never set by the script.",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "ok",
        "partial",
        "failed",
        "skipped"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "dryRun": {
      "type": "boolean"
    },
    "outputs": {
      "type": "object",
      "propertyNames": {
        "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/camelName"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.runwhen.com/error/v1.json"
      }
    },
    "logTail": {
      "type": "string",
      "maxLength": 65536
    },
    "provenance": {
      "type": "object",
      "properties": {
        "task": {
          "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/fullTaskRef"
        },
        "plugin": {
          "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/slug"
        },
        "version": {
          "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/semver"
        },
        "taskHash": {
          "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/sha256"
        },
        "archiveSha256": {
          "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/sha256"
        },
        "runtime": {
          "type": "object",
          "properties": {
            "image": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "digest": {
              "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/sha256"
            }
          },
          "additionalProperties": false
        },
        "connection": {
          "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/slug"
        },
        "runner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "leaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "taskRun": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "task",
        "taskHash"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "status",
    "startedAt",
    "finishedAt",
    "outputs",
    "errors"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "skipped"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "errors": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "partial",
              "failed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "errors": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "status": {
              "const": "skipped"
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "reason"
          ]
        }
      }
    }
  ]
}
