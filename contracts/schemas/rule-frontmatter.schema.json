{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runwhen.com/rule-frontmatter/v1.json",
  "title": "RuleFrontmatter",
  "description": "rules/<name>.md frontmatter (D59). Rules are global: no appliesTo.",
  "type": "object",
  "properties": {
    "name": {
      "$ref": "https://schemas.runwhen.com/common/v1.json#/$defs/slug"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  },
  "required": [
    "name",
    "description"
  ],
  "additionalProperties": false
}
